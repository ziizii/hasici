{
	"name": "hasici",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"setup": "node scripts/setup.mjs",
		"deploy": "node scripts/setup.mjs --deploy",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "npm run test:unit && npm run test:emulators",
		"test:e2e": "playwright test",
		"test:build": "node scripts/build-test.mjs",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:emulators": "npm run test:build && npx --yes firebase-tools@15.36.0 emulators:exec --config .firebase-test.json --project demo-hasici --only auth,firestore,hosting \"node scripts/test-rules.mjs && npm run test:e2e\"",
		"test:coverage": "npm run test:unit -- --coverage && npm run test:coverage:e2e",
		"coverage:check": "node scripts/check-coverage.mjs",
		"test:coverage:e2e": "node scripts/run-e2e-coverage.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@vitest/coverage-v8": "^5.1.1",
		"monocart-coverage-reports": "^3.2.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"firebase": "^12.19.0"
	}
}
