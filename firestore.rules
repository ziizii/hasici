rules_version = '2';

// Access model
// ------------
// Every browser signs in anonymously. A browser gets access by creating
// sessions/{uid} with a `key` that matches either the share-link key or the
// password hash stored in config/access (that document is unreadable until
// you have a session). The very first visitor creates config/access and
// config/public in one batch together with their own session.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }

    function publicPath() {
      return /databases/$(database)/documents/config/public;
    }

    function hasSession() {
      return signedIn()
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid));
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function validAccess(d) {
      return d.keys().hasOnly(['linkKey', 'passwordHash', 'updatedAt'])
        && isText(d.linkKey, 16, 128)
        && isText(d.passwordHash, 64, 64);
    }

    // Readable by anyone: tells the app whether the first-run setup happened.
    match /config/public {
      allow read: if true;
      allow create: if signedIn()
        && !exists(accessPath())
        && existsAfter(accessPath())
        && request.resource.data.keys().hasOnly(['initialized'])
        && request.resource.data.initialized == true;
      // The unit name ("SDH …") lives here so the login screen can show it.
      allow update: if hasSession()
        && request.resource.data.keys().hasOnly(['initialized', 'name'])
        && request.resource.data.initialized == true
        && isText(request.resource.data.name, 0, 60);
      allow delete: if false;
    }

    match /config/access {
      allow read: if hasSession();
      allow create: if signedIn()
        && !exists(publicPath())
        && validAccess(request.resource.data);
      allow update: if hasSession() && validAccess(request.resource.data);
      allow delete: if false;
    }

    // Default event places, edited on the Jednotka page.
    match /config/places {
      allow read: if hasSession();
      allow create, update: if hasSession()
        && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list
        && request.resource.data.list.size() <= 50;
      allow delete: if false;
    }

    match /sessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key', 'createdAt'])
        && (request.resource.data.key == getAfter(accessPath()).data.linkKey
          || request.resource.data.key == getAfter(accessPath()).data.passwordHash);
      allow update, delete: if false;
    }

    match /members/{id} {
      allow read, delete: if hasSession();
      allow create, update: if hasSession()
        && request.resource.data.keys().hasOnly(['name', 'color', 'archived', 'createdAt'])
        && isText(request.resource.data.name, 1, 60)
        && isText(request.resource.data.color, 4, 9)
        && request.resource.data.get('archived', false) is bool;
    }

    match /absences/{id} {
      allow read, delete: if hasSession();
      allow create, update: if hasSession()
        && request.resource.data.keys().hasOnly(['memberId', 'from', 'to', 'note', 'createdAt'])
        && isText(request.resource.data.memberId, 1, 64)
        && isDate(request.resource.data.from)
        && isDate(request.resource.data.to)
        && request.resource.data.from <= request.resource.data.to
        && isText(request.resource.data.note, 0, 200);
    }

    match /events/{id} {
      allow read, delete: if hasSession();
      allow create, update: if hasSession()
        && request.resource.data.keys().hasOnly(['title', 'date', 'time', 'place', 'note', 'createdAt'])
        && isText(request.resource.data.title, 1, 120)
        && isDate(request.resource.data.date)
        && isText(request.resource.data.time, 0, 5)
        && isText(request.resource.data.place, 0, 120)
        && isText(request.resource.data.note, 0, 1000);
    }
  }
}
