rules_version = '2';

// Access model
// ------------
// Every browser signs in anonymously. A browser gets access by creating
// sessions/{uid} with a `key` that matches either the share-link key or the
// password hash stored in config/access (that document is unreadable until
// you have a session). The very first visitor creates config/access and
// config/public in one batch together with their own session.
//
// Guess limit: before trying a key, a browser must write it to attempts/{uid}
// in a separate request. Each attempt has to wait longer after the previous one
// (2 s per attempt so far, up to 5 min), so a password can't be guessed quickly.
// A failed session write leaves nothing behind, which is why the attempt is its
// own write and the session rule reads it with get(), not getAfter().
//
// Logging out: config/access.revokedAt ends every session created before it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }

    function publicPath() {
      return /databases/$(database)/documents/config/public;
    }

    function sessionPath() {
      return /databases/$(database)/documents/sessions/$(request.auth.uid);
    }

    function attemptPath() {
      return /databases/$(database)/documents/attempts/$(request.auth.uid);
    }

    // A session counts only if it was made at or after the last "log out everyone".
    function hasSession() {
      return signedIn()
        && exists(sessionPath())
        && (!('revokedAt' in get(accessPath()).data)
          || get(sessionPath()).data.createdAt >= get(accessPath()).data.revokedAt);
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Series repeat rule (src/lib/repeat.ts).
    function isRepeat(r) {
      return r is map
        && r.keys().hasOnly(['freq', 'every', 'weekdays', 'days', 'nth', 'kind', 'months'])
        && r.freq in ['day', 'week', 'month', 'year']
        && r.every is int && r.every >= 1 && r.every <= 99
        && (!('weekdays' in r) || (r.weekdays is list && r.weekdays.size() <= 7))
        && (!('days' in r) || (r.days is list && r.days.size() <= 31))
        && (!('months' in r) || (r.months is list && r.months.size() <= 12))
        && (!('nth' in r) || r.nth is int)
        && (!('kind' in r) || r.kind is int);
    }

    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function validAccess(d) {
      return d.keys().hasOnly(['linkKey', 'passwordHash', 'updatedAt', 'revokedAt'])
        && isText(d.linkKey, 16, 128)
        && isText(d.passwordHash, 64, 64)
        && (!('revokedAt' in d) || d.revokedAt is timestamp);
    }

    // Readable by anyone: tells the app whether the first-run setup happened.
    match /config/public {
      allow read: if true;
      allow create: if signedIn()
        && !exists(accessPath())
        && existsAfter(accessPath())
        && request.resource.data.keys().hasOnly(['initialized'])
        && request.resource.data.initialized == true;
      // The unit name ("SDH …") lives here so the login screen can show it.
      allow update: if hasSession()
        && request.resource.data.keys().hasOnly(['initialized', 'name'])
        && request.resource.data.initialized == true
        && isText(request.resource.data.name, 0, 60);
      allow delete: if false;
    }

    match /config/access {
      allow read: if hasSession();
      // Only together with config/public, or a stray access doc would block the setup for good.
      allow create: if signedIn()
        && !exists(publicPath())
        && existsAfter(publicPath())
        && validAccess(request.resource.data);
      allow update: if hasSession()
        && validAccess(request.resource.data)
        // revokedAt can only be set to now, never moved back to let old sessions in again.
        && (request.resource.data.get('revokedAt', null) == resource.data.get('revokedAt', null)
          || request.resource.data.revokedAt == request.time);
      allow delete: if false;
    }

    // Default event places, edited on the Jednotka page.
    match /config/places {
      allow read: if hasSession();
      allow create, update: if hasSession()
        && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list
        && request.resource.data.list.size() <= 50;
      allow delete: if false;
    }

    // One per browser: the last key it tried and when. Write it before each
    // session attempt; the wait grows with every attempt (n).
    match /attempts/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validAttempt(request.resource.data)
        && request.resource.data.n == 1;
      allow update: if signedIn()
        && request.auth.uid == uid
        && validAttempt(request.resource.data)
        && request.resource.data.n == resource.data.n + 1
        && (request.time > resource.data.at + duration.value(300, 's')
          || request.time > resource.data.at + duration.value(resource.data.n * 2, 's'));
      allow delete: if false;
    }

    function validAttempt(d) {
      return d.keys().hasOnly(['key', 'at', 'n'])
        && isText(d.key, 1, 128)
        && d.at == request.time
        && d.n is int;
    }

    // The key matches the access doc, and either this browser tried that key
    // in an earlier request (guess limit), or it is the very first setup, or it
    // already has a valid session (re-keying itself when logging everyone out).
    function validSession(d) {
      return d.keys().hasOnly(['key', 'createdAt'])
        && d.createdAt == request.time
        && (d.key == getAfter(accessPath()).data.linkKey
          || d.key == getAfter(accessPath()).data.passwordHash)
        && (!exists(accessPath())
          || hasSession()
          || (exists(attemptPath()) && get(attemptPath()).data.key == d.key));
    }

    match /sessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validSession(request.resource.data);
      allow delete: if false;
    }

    match /members/{id} {
      allow read, delete: if hasSession();
      allow create, update: if hasSession()
        && request.resource.data.keys().hasOnly(['name', 'color', 'archived', 'createdAt'])
        && isText(request.resource.data.name, 1, 60)
        && isText(request.resource.data.color, 4, 9)
        && request.resource.data.get('archived', false) is bool;
    }

    match /absences/{id} {
      allow read, delete: if hasSession();
      allow create, update: if hasSession()
        && request.resource.data.keys().hasOnly(['memberId', 'from', 'to', 'note', 'weekdays', 'except', 'repeat', 'createdAt'])
        && (!('repeat' in request.resource.data) || isRepeat(request.resource.data.repeat))
        && (!('except' in request.resource.data)
          || (request.resource.data.except is list && request.resource.data.except.size() <= 100))
        && (!('weekdays' in request.resource.data)
          || (request.resource.data.weekdays is list && request.resource.data.weekdays.size() <= 7))
        && isText(request.resource.data.memberId, 1, 64)
        && isDate(request.resource.data.from)
        && isDate(request.resource.data.to)
        && request.resource.data.from <= request.resource.data.to
        && isText(request.resource.data.note, 0, 200);
    }

    match /series/{id} {
      allow read, delete: if hasSession();
      allow create, update: if hasSession()
        && request.resource.data.keys().hasOnly(['title', 'time', 'place', 'note', 'from', 'to', 'except', 'repeat', 'createdAt'])
        && (!('repeat' in request.resource.data) || isRepeat(request.resource.data.repeat))
        && isText(request.resource.data.title, 1, 120)
        && isText(request.resource.data.time, 0, 5)
        && isText(request.resource.data.place, 0, 120)
        && isText(request.resource.data.note, 0, 1000)
        && isDate(request.resource.data.from)
        && isDate(request.resource.data.to)
        && request.resource.data.from <= request.resource.data.to
        && request.resource.data.except is list && request.resource.data.except.size() <= 500;
    }

    match /events/{id} {
      allow read, delete: if hasSession();
      allow create, update: if hasSession()
        && request.resource.data.keys().hasOnly(['title', 'date', 'time', 'place', 'note', 'series', 'createdAt'])
        && (!('series' in request.resource.data) || isText(request.resource.data.series, 1, 64))
        && isText(request.resource.data.title, 1, 120)
        && isDate(request.resource.data.date)
        && isText(request.resource.data.time, 0, 5)
        && isText(request.resource.data.place, 0, 120)
        && isText(request.resource.data.note, 0, 1000);
    }
  }
}
